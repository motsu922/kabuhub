{
  "expo": {
    "name": "KabuHub",
    "slug": "kabuhub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "kabuhub",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06090F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kabuhub.app",
      "buildNumber": "14",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06090F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kabuhub.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-share-intent",
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "268aa00c-373a-4a8f-8664-7b0102f9b907"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/268aa00c-373a-4a8f-8664-7b0102f9b907",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}

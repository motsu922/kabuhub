rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /master/{seiban} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // 異常記録：追記のみ、削除・更新は不可（ログとして保全）
    match /anomalies/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // 異常種別マスター：認証ユーザーが管理
    match /anomalyTypes/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // KabuHub コメント（匿名・認証不要）
    match /comments/{symbol}/messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() <= 50
                    && request.resource.data.userId is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['reportCount', 'status']);
    }

    // KabuHub 手動クラウド同期（同期IDを知っている端末のみ）
    match /userSyncBackups/{syncId} {
      allow get: if isValidSyncId(syncId);
      allow create, update: if isValidSyncId(syncId);
      allow list, delete: if false;
    }

    function isValidSyncId(syncId) {
      return syncId.matches('^kh-[a-z0-9]{5}-[a-z0-9]{5}$');
    }
  }
}
